/*
 * CORS.zen v1.0.0
 * Cross-Origin Resource Sharing utilities for Zen HTTP servers.
 * author Jishith M P
 */

struct Cors {
  private string origin = "*"
  private string methods = "GET, POST, PUT, DELETE, OPTIONS"
  private string headers = "Content-Type, Authorization"
  private string exposeHeaders = ""
  private bool credentials = false
  private int maxAge = 86400

  setOrigin(string origin) void {
    this.origin = origin
  }

  setMethods(string methods) void {
    this.methods = methods
  }

  setHeaders(string headers) void {
    this.headers = headers
  }

  setExposeHeaders(string headers) void {
    this.exposeHeaders = headers
  }

  setCredentials(bool credentials) void {
    this.credentials = credentials
  }

  setMaxAge(int seconds) void {
    this.maxAge = seconds
  }

  apply(HttpRequest req) void {
    req.setHeader("Access-Control-Allow-Origin", this.origin)
    req.setHeader("Access-Control-Allow-Methods", this.methods)
    req.setHeader("Access-Control-Allow-Headers", this.headers)

    if (this.exposeHeaders != "") {
      req.setHeader("Access-Control-Expose-Headers", this.exposeHeaders)
    }

    if (this.credentials) {
      req.setHeader("Access-Control-Allow-Credentials", "true")
    }

    req.setHeader("Access-Control-Max-Age", String(this.maxAge))
  }
}

export(Cors)
